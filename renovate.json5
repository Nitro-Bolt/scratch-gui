{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:base"
  ],

  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "scratch-vm",
        "scratch-blocks",
        "scratch-paint",
        "scratch-render"
      ],
      "enabled": true
    }
  ]
}
