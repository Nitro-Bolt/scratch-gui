{
  "name": "scratch-gui",
  "version": "3.2.37",
  "packageManager": "pnpm@10.33.0",
  "description": "Graphical User Interface for creating and running Scratch 3.0 projects",
  "author": "Massachusetts Institute of Technology",
  "license": "GPL-3.0",
  "homepage": "https://github.com/LLK/scratch-gui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/LLK/scratch-gui.git"
  },
  "main": "./dist/scratch-gui.js",
  "scripts": {
    "build": "pnpm run prepublish && pnpm run clean && rspack build",
    "clean": "rimraf ./build && mkdirp build && rimraf ./dist && mkdirp dist",
    "deploy": "touch build/.nojekyll && gh-pages -t -d build -m \"[skip ci] Build for $(git log --pretty=format:%H -n1)\"",
    "prepublish": "node scripts/prepublish.mjs",
    "prune": "./prune-gh-pages.sh",
    "i18n:push": "tx-push-src scratch-editor interface translations/en.json",
    "i18n:src": "rimraf ./translations/messages/src && babel src > tmp.js && rimraf tmp.js && build-i18n-src ./translations/messages/src ./translations/",
    "start": "rspack dev",
    "test": "pnpm run test:lint && pnpm run test:unit && pnpm run build && pnpm run test:integration",
    "test:integration": "jest --maxWorkers=4 test[\\\\/]integration",
    "test:lint": "eslint . --ext .js,.jsx",
    "test:unit": "jest test[\\\\/]unit[\\\\/]addons",
    "test:smoke": "jest --runInBand test[\\\\/]smoke",
    "watch": "rspack build --watch"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@microbit/microbit-universal-hex": "0.2.2",
    "@nitro-bolt/scratch-storage": "^1.0.1",
    "@turbowarp/jszip": "^3.11.1",
    "@turbowarp/nanolog": "^1.0.1",
    "@turbowarp/scratch-l10n": "^3.1001.0-202401241456-994097a5",
    "@turbowarp/scratch-svg-renderer": "^1.1.0",
    "@turbowarp/startaudiocontext": "^1.0.0",
    "arraybuffer-loader": "^1.0.6",
    "autoprefixer": "^10.4.21",
    "balance-text": "3.3.1",
    "base64-loader": "1.0.0",
    "bowser": "1.9.4",
    "buffer": "^6.0.3",
    "classnames": "2.2.6",
    "computed-style-to-inline-style": "3.0.0",
    "cookie": "0.5.0",
    "core-js": "2.5.7",
    "css-loader": "^7.1.2",
    "dapjs": "2.3.0",
    "es6-object-assign": "1.1.0",
    "get-float-time-domain-data": "0.1.0",
    "get-user-media-promise": "1.1.4",
    "htmlparser2": "^9.1.0",
    "intl": "1.2.5",
    "intl-messageformat": "^2.2.0",
    "istextorbinary": "^9.5.0",
    "js-base64": "2.4.9",
    "js-md5": "0.7.3",
    "keymirror": "0.1.1",
    "lamejs": "^1.2.0",
    "lodash.bindall": "4.4.0",
    "lodash.debounce": "4.0.8",
    "lodash.defaultsdeep": "4.6.1",
    "lodash.omit": "4.5.0",
    "lodash.throttle": "4.0.1",
    "monaco-editor": "^0.52.2",
    "omggif": "1.0.9",
    "papaparse": "5.3.0",
    "path-browserify": "^1.0.1",
    "postcss-import": "^16.1.0",
    "postcss-loader": "^8.2.0",
    "postcss-simple-vars": "^7.0.1",
    "prop-types": "^15.5.10",
    "query-string": "^5.1.1",
    "react": "^16.0.0",
    "react-contextmenu": "2.9.4",
    "react-dom": "^16.0.0",
    "react-draggable": "3.0.5",
    "react-ga": "2.5.3",
    "react-intl": "2.9.0",
    "react-modal": "3.9.1",
    "react-monaco-editor": "^0.59.0",
    "react-popover": "0.5.10",
    "react-redux": "5.0.7",
    "react-responsive": "5.0.0",
    "react-sparklines": "1.7.0",
    "react-string-replace": "^0.4.4",
    "react-style-proptype": "3.2.2",
    "react-tabs": "2.3.0",
    "react-tooltip": "3.8.0",
    "react-virtualized": "9.20.1",
    "redux": "3.7.2",
    "redux-throttle": "0.1.1",
    "regenerator-runtime": "^0.14.1",
    "scratch-audio": "github:TurboWarp/scratch-audio#develop",
    "scratch-blocks": "github:Nitro-Bolt/scratch-blocks#develop-builds",
    "scratch-paint": "github:Nitro-Bolt/scratch-paint#develop",
    "scratch-render": "github:Nitro-Bolt/scratch-render#develop",
    "scratch-vm": "github:Nitro-Bolt/scratch-vm#develop",
    "style-loader": "^4.0.0",
    "text-encoding": "0.7.0",
    "to-style": "1.3.3",
    "url": "^0.11.4",
    "wav-encoder": "1.3.0",
    "xhr": "2.5.0"
  },
  "peerDependencies": {
    "react": "^16.0.0",
    "react-dom": "^16.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@rspack/cli": "^2.1.1",
    "@rspack/core": "^2.1.1",
    "@rspack/dev-server": "^2.1.1",
    "babel-eslint": "10.1.0",
    "babel-loader": "^10.0.0",
    "chromedriver": "117.0.3",
    "cross-fetch": "^3.1.5",
    "enzyme": "3.10.0",
    "enzyme-adapter-react-16": "1.15.7",
    "events": "^3.3.0",
    "eslint": "8.55.0",
    "eslint-config-scratch": "9.0.3",
    "eslint-import-resolver-webpack": "0.11.1",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jest": "22.17.0",
    "eslint-plugin-react": "7.33.2",
    "gh-pages": "3.2.3",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^29.7.0",
    "jest-junit": "7.0.0",
    "mkdirp": "1.0.3",
    "monaco-editor-webpack-plugin": "^7.1.1",
    "raf": "3.4.1",
    "react-test-renderer": "16.14.0",
    "redux-mock-store": "1.5.3",
    "rimraf": "2.7.1",
    "selenium-webdriver": "3.6.0",
    "web-audio-test-api": "0.5.2",
    "yauzl": "2.10.0"
  },
  "jest": {
    "setupFiles": [
      "raf/polyfill",
      "<rootDir>/test/helpers/enzyme-setup.js"
    ],
    "testPathIgnorePatterns": [
      "src/test.js"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/test/__mocks__/fileMock.js",
      "\\.(css|less)$": "<rootDir>/test/__mocks__/styleMock.js",
      "editor-msgs(\\.js)?$": "<rootDir>/test/__mocks__/editor-msgs-mock.js"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "chromedriver",
      "core-js",
      "es5-ext"
    ]
  }
}
